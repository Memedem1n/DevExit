generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  avatar            String?   // Custom field for our UI
  currentRole       String    @default("DEVELOPER")
  isProfileComplete Boolean   @default(false)
  isVerified        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  accounts          Account[]
  sessions          Session[]
  projects          Project[] @relation("UserProjects")
  offersSent        Offer[]   @relation("UserOffersSent")
  sentMessages      Message[] @relation("SentMessages")
  receivedMessages  Message[] @relation("ReceivedMessages")
  watchlist         Watchlist[]
  notifications     Notification[]
  ndas              NDA[]
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // OFFER, MESSAGE, STATUS_CHANGE, WATCHLIST
  message     String
  link        String?  
  isRead      Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Message {
  id          String   @id @default(cuid())
  content     String
  fileUrl     String?
  fileType    String?  // IMAGE, PDF, DOC, etc.
  senderId    String
  receiverId  String
  projectId   String?
  isRead      Boolean  @default(false)
  
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])

  createdAt   DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? 
  access_token      String? 
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? 
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String
  type            String   // SaaS, Mobile, E-Commerce, etc.
  techStack       String   // Comma separated or JSON string for SQLite compatibility
  mmr             Float    @default(0)
  price           Float
  growth          String?  // e.g. "+12%"
  status          String   @default("PUBLISHED") // DRAFT, PENDING, PUBLISHED, SOLD
  isVerified      Boolean  @default(false)
  
  // Analytics Simulation
  views           Int      @default(0)
  
  // External Data
  storeUrl        String?
  revenueCatId    String?
  screenshots     String?  // Comma separated URLs
  
  // Advanced Metrics
  revenueModel    String?  // SUBSCRIPTION, ONE_TIME, FREEMIUM, AD_BASED
  churnRate       Float?   
  ltv             Float?   
  arpu            Float?   
  
  // Detailed Performance Metrics
  mau             Int?     // Monthly Active Users
  last28DayRevenue Float?
  monthlyDownloads Int?
  appAge          String?  // e.g. "2 years"
  monthlyExpenses Float?   @default(0)
  
  // Pricing & Strategy
  pricingStrategy String   @default("FIXED") // FIXED, OFFERS
  isOffersAccepted Boolean @default(true)
  
  // Transfer Details
  assetsIncluded  String?  // Comma separated: Code, Domain, Assets, etc.
  reasonForSelling String?
  visibility      String   @default("PUBLIC") // PUBLIC, PRIVATE
  
  // App Store Metadata
  appSize         String?  
  ageRating       String?  // e.g. "4+"
  languages       String?  // e.g. "EN, TR, ES"
  lastUpdate      DateTime?
  rating          Float?   @default(0)
  reviewCount     Int?     @default(0)
  
  // Relations
  userId          String
  user            User     @relation("UserProjects", fields: [userId], references: [id])
  offers          Offer[]  @relation("ProjectOffers")
  messages        Message[]
  watchlistedBy   Watchlist[]
  ndas            NDA[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model NDA {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  signedAt  DateTime @default(now())

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model Offer {
  id        String   @id @default(cuid())
  amount    Float
  message   String?
  status    String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  
  // Relations
  projectId String
  project   Project  @relation("ProjectOffers", fields: [projectId], references: [id])
  buyerId   String
  buyer     User     @relation("UserOffersSent", fields: [buyerId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([buyerId])
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
}
